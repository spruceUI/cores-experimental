# cores-standalone-flycast-t3 v1: cores-arm64-standalone v1 plus Arm's GNU Toolchain 10.3-2021.07 at /opt/arm-gnu-10.3,
# for flycast-standalone-t3-lto (docs/standalone.md). From developer.arm.com (toolchain-inputs/README.md).
FROM sha256:c630f837fad078ea0d34db3208247eaa820f056c245a5587572723ca6c68fe10

COPY gcc-arm-10.3-2021.07-x86_64-aarch64-none-linux-gnu.tar.xz /tmp/
RUN echo "1e33d53dea59c8de823bbdfe0798280bdcd138636c7060da9d77a97ded095a84  /tmp/gcc-arm-10.3-2021.07-x86_64-aarch64-none-linux-gnu.tar.xz" | sha256sum -c - && \
    mkdir -p /opt/arm-gnu-10.3 && \
    tar xJf /tmp/gcc-arm-10.3-2021.07-x86_64-aarch64-none-linux-gnu.tar.xz -C /opt/arm-gnu-10.3 --strip-components=1 && \
    rm /tmp/gcc-arm-10.3-2021.07-x86_64-aarch64-none-linux-gnu.tar.xz && \
    test -x /opt/arm-gnu-10.3/bin/aarch64-none-linux-gnu-gcc
