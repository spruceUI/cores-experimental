# cores-standalone-miyoomini v1: the build environment of spruceUI/vTree-spruce@a0e1266
# (Dockerfile.miyoomini): aemiii91/miyoomini-toolchain, pinned to the digest its floating
# `latest` tag has had since 2026-01-20 (the vTree build ran on 2026-04-21).
FROM aemiii91/miyoomini-toolchain@sha256:e5123590ad75d27f0f4c91196e3119a255cad45f3ae15243e29a8e0a2ec50132

ENV PATH="/opt/miyoomini-toolchain/usr/bin:${PATH}"

RUN test -x /opt/miyoomini-toolchain/usr/bin/arm-linux-gnueabihf-gcc && \
    command -v git && command -v python3 && command -v sha256sum && \
    (dpkg -l > /apt-manifest.txt 2>/dev/null || true)
