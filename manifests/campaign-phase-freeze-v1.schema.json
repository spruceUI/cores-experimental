{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spruceui.local/schemas/campaign-phase-freeze-v1.schema.json",
  "$comment": "Structural schema for the strict local-only phase-freeze authority. Mandatory Python decoding additionally authenticates every nested digest, exact role policy, ordering, semantic binding, and transition delta.",
  "title": "Spruce campaign phase freeze v1",
  "type": "object",
  "required": [
    "schema_version",
    "format",
    "campaign_id",
    "transition_id",
    "captured_at",
    "predecessor",
    "authorities",
    "local_only",
    "publication",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "format": {
      "const": "spruce-phase-freeze-v1"
    },
    "campaign_id": {
      "$ref": "#/$defs/identifier"
    },
    "transition_id": {
      "$ref": "#/$defs/identifier"
    },
    "captured_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "predecessor": {
      "$ref": "#/$defs/predecessorEvidence"
    },
    "authorities": {
      "type": "object",
      "required": [
        "catalog",
        "commit-blacklist",
        "core-spec-set",
        "host-execution",
        "instrumentation",
        "recipe-auxiliaries",
        "schemas",
        "spruce-branch-bases",
        "spruce-release-roster",
        "telemetry-schema",
        "toolchain-lock",
        "tracks",
        "tunings",
        "workflows"
      ],
      "properties": {
        "catalog": {
          "$ref": "#/$defs/artifactEvidence"
        },
        "commit-blacklist": {
          "$ref": "#/$defs/artifactEvidence"
        },
        "core-spec-set": {
          "$ref": "#/$defs/artifactEvidence"
        },
        "host-execution": {
          "$ref": "#/$defs/artifactEvidence"
        },
        "instrumentation": {
          "$ref": "#/$defs/artifactEvidence"
        },
        "recipe-auxiliaries": {
          "$ref": "#/$defs/artifactEvidence"
        },
        "schemas": {
          "$ref": "#/$defs/artifactEvidence"
        },
        "spruce-branch-bases": {
          "$ref": "#/$defs/artifactEvidence"
        },
        "spruce-release-roster": {
          "$ref": "#/$defs/artifactEvidence"
        },
        "telemetry-schema": {
          "$ref": "#/$defs/artifactEvidence"
        },
        "toolchain-lock": {
          "$ref": "#/$defs/artifactEvidence"
        },
        "tracks": {
          "$ref": "#/$defs/tracksEvidence"
        },
        "tunings": {
          "$ref": "#/$defs/artifactEvidence"
        },
        "workflows": {
          "$ref": "#/$defs/artifactEvidence"
        }
      },
      "additionalProperties": false
    },
    "local_only": {
      "const": true
    },
    "publication": {
      "const": "disabled"
    },
    "content_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence": {
      "type": "object",
      "required": [
        "schema_version",
        "kind",
        "path",
        "file_sha256",
        "target_content_sha256",
        "size",
        "content_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "file_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "target_content_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "content_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "artifactEvidence": {
      "allOf": [
        {
          "$ref": "#/$defs/evidence"
        },
        {
          "properties": {
            "kind": {
              "const": "artifact"
            }
          }
        }
      ]
    },
    "tracksEvidence": {
      "allOf": [
        {
          "$ref": "#/$defs/evidence"
        },
        {
          "properties": {
            "kind": {
              "enum": [
                "artifact",
                "track-registry"
              ]
            }
          }
        }
      ]
    },
    "predecessorEvidence": {
      "allOf": [
        {
          "$ref": "#/$defs/evidence"
        },
        {
          "properties": {
            "kind": {
              "enum": [
                "phase-freeze",
                "phase-freeze-cas"
              ]
            }
          }
        }
      ]
    }
  }
}
