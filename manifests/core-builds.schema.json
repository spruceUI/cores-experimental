{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spruceui.local/schemas/core-builds.schema.json",
  "title": "Cores-spruce local build catalog",
  "type": "object",
  "required": [
    "schema_version",
    "policy",
    "commit_blacklist",
    "toolchain_lock",
    "toolchain_lock_validator",
    "toolchains",
    "resolver",
    "cores"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "policy": {
      "type": "object",
      "required": [
        "publication",
        "source_pins",
        "promotion_requires"
      ],
      "properties": {
        "publication": {
          "const": "disabled"
        },
        "source_pins": {
          "const": "full-commit-sha-only"
        },
        "promotion_requires": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "commit_blacklist": {
      "type": "object",
      "required": [
        "path",
        "schema_version",
        "policy_id",
        "file_sha256",
        "content_sha256"
      ],
      "properties": {
        "path": {
          "const": "policies/core-commit-blacklist.json"
        },
        "schema_version": {
          "const": 1
        },
        "policy_id": {
          "const": "core-commit-blacklist-v1"
        },
        "file_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "content_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "toolchain_lock": {
      "type": "object",
      "required": [
        "path",
        "schema_version",
        "lock_id",
        "file_sha256",
        "content_sha256"
      ],
      "properties": {
        "path": {
          "const": "pins/toolchains/local-cache-v1.json"
        },
        "schema_version": {
          "const": 1
        },
        "lock_id": {
          "const": "local-cache-v1"
        },
        "file_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "content_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "toolchain_lock_validator": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "const": "scripts/toolchain_archive.py"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "toolchains": {
      "type": "object",
      "required": [
        "arm64",
        "armhf"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/toolchain"
      }
    },
    "resolver": {
      "type": "object",
      "required": [
        "libretro_super_commit",
        "core_rules_path",
        "core_rules_sha256",
        "fetch_script_path",
        "fetch_script_sha256",
        "build_script_path",
        "build_script_sha256"
      ]
    },
    "cores": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "picodrive": {
          "$ref": "#/$defs/core"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/nonNativeCore"
      }
    }
  },
  "$defs": {
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "portableFfmpegMakeVariables": {
      "type": "object",
      "required": [
        "ARCH_AARCH64",
        "ARCH_ARM",
        "ARCH_X86",
        "ARCH_X86_64",
        "HAVE_SSA",
        "LIBRETRO_EMBED_FFMPEG",
        "OPENGL"
      ],
      "properties": {
        "ARCH_AARCH64": {
          "const": 0
        },
        "ARCH_ARM": {
          "const": 0
        },
        "ARCH_X86": {
          "const": 0
        },
        "ARCH_X86_64": {
          "const": 0
        },
        "HAVE_SSA": {
          "const": 0
        },
        "LIBRETRO_EMBED_FFMPEG": {
          "const": 1
        },
        "OPENGL": {
          "const": 0
        }
      },
      "additionalProperties": false
    },
    "vecxSoftwareMakeVariables": {
      "type": "object",
      "required": [
        "HAS_GPU"
      ],
      "properties": {
        "HAS_GPU": {
          "const": 0
        }
      },
      "additionalProperties": false
    },
    "pcfxPortableMakeVariables": {
      "type": "object",
      "required": [
        "IS_X86"
      ],
      "properties": {
        "IS_X86": {
          "const": 0
        }
      },
      "additionalProperties": false
    },
    "snes9x2005PlusMakeVariables": {
      "type": "object",
      "required": [
        "USE_BLARGG_APU"
      ],
      "properties": {
        "USE_BLARGG_APU": {
          "const": 1
        }
      },
      "additionalProperties": false
    },
    "picodriveRecipeProfile": {
      "type": "object",
      "required": [
        "kind",
        "git_revision",
        "armhf_host_tools"
      ],
      "propertyNames": {
        "enum": [
          "kind",
          "git_revision",
          "armhf_host_tools"
        ]
      },
      "properties": {
        "kind": {
          "const": "picodrive-v1"
        },
        "git_revision": {
          "const": "-f0d4a011"
        },
        "armhf_host_tools": {
          "type": "object",
          "required": [
            "CYCLONE_CC",
            "CYCLONE_CXX"
          ],
          "propertyNames": {
            "enum": [
              "CYCLONE_CC",
              "CYCLONE_CXX"
            ]
          },
          "properties": {
            "CYCLONE_CC": {
              "const": "gcc"
            },
            "CYCLONE_CXX": {
              "const": "g++"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "gitVersion": {
      "type": "object",
      "required": [
        "derivation",
        "value"
      ],
      "properties": {
        "derivation": {
          "const": "hyphen-short7-v1"
        },
        "value": {
          "type": "string",
          "pattern": "^-[0-9a-f]{7}$"
        },
        "compiler_scope": {
          "const": "cxx"
        }
      },
      "additionalProperties": false
    },
    "nativeGitVersion": {
      "type": "object",
      "required": [
        "derivation",
        "value"
      ],
      "properties": {
        "derivation": {
          "const": "native-space-short7-v1"
        },
        "value": {
          "type": "string",
          "pattern": "^ [0-9a-f]{7}$"
        },
        "compiler_scope": {
          "enum": [
            "c",
            "cxx"
          ]
        }
      },
      "additionalProperties": false
    },
    "mgbaNativeGitVersion": {
      "type": "object",
      "required": [
        "derivation",
        "value",
        "compiler_scope"
      ],
      "properties": {
        "derivation": {
          "const": "native-space-short9-v1"
        },
        "value": {
          "const": " 6dce57eef"
        },
        "compiler_scope": {
          "const": "c"
        }
      },
      "additionalProperties": false
    },
    "mame2003PlusNativeGitVersion": {
      "type": "object",
      "required": [
        "derivation",
        "value",
        "compiler_scope"
      ],
      "properties": {
        "derivation": {
          "const": "native-space-short8-v1"
        },
        "value": {
          "const": " 5373e38e"
        },
        "compiler_scope": {
          "const": "c"
        }
      },
      "additionalProperties": false
    },
    "fbneoNativeVersion": {
      "type": "object",
      "required": [
        "derivation",
        "value",
        "git_date",
        "compiler_scope"
      ],
      "properties": {
        "derivation": {
          "const": "fbneo-native-short9-date-v1"
        },
        "value": {
          "const": "9d7716aa2"
        },
        "git_date": {
          "const": "260503"
        },
        "compiler_scope": {
          "const": "cxx"
        }
      },
      "additionalProperties": false
    },
    "nativeGitDescribeVersion": {
      "type": "object",
      "required": [
        "derivation",
        "value"
      ],
      "properties": {
        "derivation": {
          "const": "native-git-describe-v1"
        },
        "value": {
          "const": "1.6.6-11-g1123457"
        }
      },
      "additionalProperties": false
    },
    "viceNativeGitVersion": {
      "type": "object",
      "required": [
        "derivation",
        "value"
      ],
      "properties": {
        "derivation": {
          "const": "native-space-short10-v1"
        },
        "value": {
          "const": " 7946cfa0d3"
        }
      },
      "additionalProperties": false
    },
    "metadataReplacement": {
      "oneOf": [
        {
          "$ref": "#/$defs/atari800MetadataReplacement"
        },
        {
          "$ref": "#/$defs/picodriveMetadataReplacement"
        },
        {
          "$ref": "#/$defs/vecxMetadataReplacement"
        }
      ]
    },
    "atari800MetadataReplacement": {
      "type": "object",
      "required": [
        "kind",
        "path",
        "preimage_sha256",
        "replacement_sha256"
      ],
      "properties": {
        "kind": {
          "const": "whole-file-v1"
        },
        "path": {
          "const": "metadata/atari800/source-v1.info"
        },
        "preimage_sha256": {
          "const": "1682c00740626f0bc709dbbcdae1777222773b93a1007bc02e4024df7b181653"
        },
        "replacement_sha256": {
          "const": "4b56fa399760a8c48e6ac8b08ecc2ae2f7163bbfb34f3f08351bc7e092602e5e"
        }
      },
      "additionalProperties": false
    },
    "picodriveMetadataReplacement": {
      "type": "object",
      "required": [
        "kind",
        "path",
        "preimage_sha256",
        "replacement_sha256"
      ],
      "properties": {
        "kind": {
          "const": "whole-file-v1"
        },
        "path": {
          "const": "metadata/picodrive/source-v1.info"
        },
        "preimage_sha256": {
          "const": "35cef57b4b61d95a86e1ceee3a7c325d9d16bbdc136b4b3a556e808864de06c5"
        },
        "replacement_sha256": {
          "const": "ee4443f075c57c90b4d7a99c3a7c7e54ee141b21899dc88a3c8c52152556e181"
        }
      },
      "additionalProperties": false
    },
    "vecxMetadataReplacement": {
      "type": "object",
      "required": [
        "kind",
        "path",
        "preimage_sha256",
        "replacement_sha256"
      ],
      "properties": {
        "kind": {
          "const": "whole-file-v1"
        },
        "path": {
          "const": "metadata/vecx/software-v1.info"
        },
        "preimage_sha256": {
          "const": "9eec259b2b84256aca32cdcd37b084732b17d2fce829dac01bab9a84ea01b4e3"
        },
        "replacement_sha256": {
          "const": "2f22e8069a304878b52aeb5d7f789812bf271c61e5c41e0cb0fbd6acb5d28c1a"
        }
      },
      "additionalProperties": false
    },
    "toolchain": {
      "type": "object",
      "required": [
        "image",
        "image_id",
        "dockerfile",
        "dockerfile_sha256",
        "dockerfile_linkage"
      ],
      "properties": {
        "image": {
          "type": "string"
        },
        "image_id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "dockerfile": {
          "type": "string"
        },
        "dockerfile_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "dockerfile_linkage": {
          "const": "unverified-local-cache"
        }
      },
      "additionalProperties": false
    },
    "nonNativeCore": {
      "allOf": [
        {
          "$ref": "#/$defs/core"
        },
        {
          "properties": {
            "build": {
              "properties": {
                "git_version": {
                  "$ref": "#/$defs/gitVersion"
                }
              },
              "not": {
                "required": [
                  "recipe_profile"
                ]
              }
            }
          }
        }
      ]
    },
    "core": {
      "type": "object",
      "required": [
        "workflow",
        "source",
        "build",
        "metadata",
        "targets"
      ],
      "properties": {
        "workflow": {
          "type": "string"
        },
        "source": {
          "type": "object",
          "required": [
            "url",
            "requested_ref",
            "commit"
          ],
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^https://"
            },
            "requested_ref": {
              "type": "string",
              "minLength": 1
            },
            "commit": {
              "$ref": "#/$defs/sha1"
            },
            "tree": {
              "$ref": "#/$defs/sha1"
            },
            "submodules": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "path",
                  "commit"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "commit": {
                    "$ref": "#/$defs/sha1"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "build": {
          "type": "object",
          "required": [
            "driver",
            "source_dir",
            "output_path",
            "artifact_name"
          ],
          "properties": {
            "driver": {
              "enum": [
                "libretro-super",
                "direct-make",
                "direct-cmake",
                "direct-cargo"
              ]
            },
            "source_key": {
              "type": "string"
            },
            "source_dir": {
              "type": "string"
            },
            "output_path": {
              "type": "string"
            },
            "artifact_name": {
              "type": "string",
              "pattern": "_libretro\\.so$"
            },
            "generated_source": {
              "type": "object",
              "required": [
                "kind",
                "path",
                "sha256"
              ],
              "properties": {
                "kind": {
                  "const": "post-build-sha256-v1"
                },
                "path": {
                  "type": "string",
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._+-]+(?:/[A-Za-z0-9._+-]+)*$"
                },
                "sha256": {
                  "$ref": "#/$defs/sha256"
                }
              },
              "additionalProperties": false
            },
            "source_date_epoch": {
              "type": "integer",
              "minimum": 1,
              "maximum": 253402300799
            },
            "platforms": {
              "type": "object",
              "required": [
                "arm64",
                "armhf"
              ],
              "additionalProperties": {
                "type": "string"
              }
            },
            "compile_definitions": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {
                "enum": [
                  "arm64",
                  "armhf"
                ]
              },
              "additionalProperties": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Z_][A-Z0-9_]*=(0|[1-9][0-9]{0,9})$"
                }
              }
            },
            "recipe_profile": {
              "$ref": "#/$defs/picodriveRecipeProfile"
            },
            "make_variables": {
              "oneOf": [
                {
                  "$ref": "#/$defs/portableFfmpegMakeVariables"
                },
                {
                  "$ref": "#/$defs/vecxSoftwareMakeVariables"
                },
                {
                  "$ref": "#/$defs/pcfxPortableMakeVariables"
                },
                {
                  "$ref": "#/$defs/snes9x2005PlusMakeVariables"
                }
              ]
            },
            "git_version": {
              "oneOf": [
                {
                  "$ref": "#/$defs/gitVersion"
                },
                {
                  "$ref": "#/$defs/nativeGitVersion"
                },
                {
                  "$ref": "#/$defs/fbneoNativeVersion"
                },
                {
                  "$ref": "#/$defs/mame2003PlusNativeGitVersion"
                },
                {
                  "$ref": "#/$defs/mgbaNativeGitVersion"
                },
                {
                  "$ref": "#/$defs/nativeGitDescribeVersion"
                },
                {
                  "$ref": "#/$defs/viceNativeGitVersion"
                }
              ]
            },
            "cmake": {
              "type": "object",
              "required": [
                "generator",
                "build_type",
                "target",
                "systems"
              ],
              "properties": {
                "generator": {
                  "const": "Unix Makefiles"
                },
                "build_type": {
                  "const": "Release"
                },
                "target": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_+-]+$"
                },
                "systems": {
                  "type": "object",
                  "minProperties": 1,
                  "properties": {
                    "arm64": {
                      "type": "object",
                      "required": [
                        "name",
                        "processor"
                      ],
                      "properties": {
                        "name": {
                          "const": "Linux"
                        },
                        "processor": {
                          "const": "aarch64"
                        },
                        "defines": {
                          "type": "object",
                          "minProperties": 1,
                          "propertyNames": {
                            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                          },
                          "additionalProperties": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9_./+=-]+$"
                          }
                        }
                      },
                      "additionalProperties": false
                    },
                    "armhf": {
                      "type": "object",
                      "required": [
                        "name",
                        "processor"
                      ],
                      "properties": {
                        "name": {
                          "const": "Linux"
                        },
                        "processor": {
                          "const": "arm"
                        },
                        "defines": {
                          "type": "object",
                          "minProperties": 1,
                          "propertyNames": {
                            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                          },
                          "additionalProperties": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9_./+=-]+$"
                          }
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            },
            "overlays": {
              "type": "object",
              "minProperties": 1,
              "properties": {
                "arm64": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/overlay"
                  }
                },
                "armhf": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/overlay"
                  }
                }
              },
              "additionalProperties": false
            },
            "cargo": {
              "type": "object",
              "required": [
                "subdir",
                "profile",
                "lock_sha256",
                "targets"
              ],
              "properties": {
                "subdir": {
                  "type": "string",
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._+-]+(?:/[A-Za-z0-9._+-]+)*$"
                },
                "profile": {
                  "const": "release"
                },
                "lock_sha256": {
                  "$ref": "#/$defs/sha256"
                },
                "targets": {
                  "type": "object",
                  "required": [
                    "arm64",
                    "armhf"
                  ],
                  "properties": {
                    "arm64": {
                      "type": "string",
                      "pattern": "^aarch64-unknown-linux-gnu(\\.[0-9]+(\\.[0-9]+)*)?$"
                    },
                    "armhf": {
                      "type": "string",
                      "pattern": "^armv7-unknown-linux-gnueabihf(\\.[0-9]+(\\.[0-9]+)*)?$"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "required": [
                  "git_version"
                ]
              },
              "then": {
                "properties": {
                  "driver": {
                    "const": "libretro-super"
                  }
                },
                "anyOf": [
                  {
                    "not": {
                      "required": [
                        "compile_definitions"
                      ]
                    }
                  },
                  {
                    "required": [
                      "compile_definitions"
                    ],
                    "properties": {
                      "git_version": {
                        "$ref": "#/$defs/fbneoNativeVersion"
                      },
                      "compile_definitions": {
                        "const": {
                          "armhf": [
                            "HWCAP2_AES=1",
                            "HWCAP2_CRC32=16",
                            "HWCAP2_SHA1=4",
                            "HWCAP2_SHA2=8"
                          ]
                        }
                      }
                    }
                  }
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "git_version": {
                    "$ref": "#/$defs/gitVersion"
                  }
                },
                "required": [
                  "git_version"
                ]
              },
              "then": {
                "not": {
                  "required": [
                    "make_variables"
                  ]
                }
              }
            },
            {
              "if": {
                "required": [
                  "make_variables"
                ]
              },
              "then": {
                "properties": {
                  "driver": {
                    "const": "libretro-super"
                  }
                },
                "not": {
                  "required": [
                    "compile_definitions"
                  ]
                }
              }
            },
            {
              "if": {
                "properties": {
                  "make_variables": {
                    "$ref": "#/$defs/portableFfmpegMakeVariables"
                  }
                },
                "required": [
                  "make_variables"
                ]
              },
              "then": {
                "required": [
                  "source_date_epoch"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "driver": {
                    "const": "direct-cmake"
                  }
                },
                "required": [
                  "driver"
                ]
              },
              "then": {
                "required": [
                  "source_date_epoch",
                  "cmake"
                ],
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "source_key"
                      ]
                    },
                    {
                      "required": [
                        "platforms"
                      ]
                    },
                    {
                      "required": [
                        "compile_definitions"
                      ]
                    },
                    {
                      "required": [
                        "recipe_profile"
                      ]
                    }
                  ]
                }
              },
              "else": {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "cmake"
                      ]
                    },
                    {
                      "required": [
                        "overlays"
                      ]
                    }
                  ]
                }
              }
            }
          ]
        },
        "metadata": {
          "type": "object",
          "required": [
            "source_path",
            "artifact_name"
          ],
          "properties": {
            "source_path": {
              "type": "string",
              "pattern": "^/libretro-super/dist/info/[A-Za-z0-9_+-]+_libretro\\.info$"
            },
            "artifact_name": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_+-]+_libretro\\.info$"
            },
            "replacement": {
              "$ref": "#/$defs/metadataReplacement"
            }
          },
          "additionalProperties": false
        },
        "validation": {
          "type": "object",
          "required": [
            "forbidden_needed_prefixes"
          ],
          "properties": {
            "forbidden_needed_prefixes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^lib[A-Za-z0-9_+.-]+$"
              }
            }
          },
          "additionalProperties": false
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "arm64",
              "armhf"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "overlay": {
      "type": "object",
      "required": [
        "kind",
        "patch_path",
        "patch_sha256",
        "source_path",
        "preimage_sha256",
        "postimage_sha256"
      ],
      "properties": {
        "kind": {
          "const": "git-apply-v1"
        },
        "patch_path": {
          "type": "string",
          "pattern": "^patches/(?!.*\\.\\.)[A-Za-z0-9_+./-]+\\.patch$"
        },
        "patch_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_+./-]+$"
        },
        "preimage_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "postimage_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    }
  }
}
