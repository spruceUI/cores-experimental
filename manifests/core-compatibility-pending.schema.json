{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spruceui.local/schemas/core-compatibility-pending.schema.json",
  "title": "Cores-spruce pending individual-core compatibility evidence",
  "type": "object",
  "required": [
    "$schema",
    "schema_version",
    "core_id",
    "state",
    "publication",
    "core_spec_sha256",
    "source_commit",
    "targets",
    "next_gate",
    "content_sha256"
  ],
  "properties": {
    "$schema": {"const": "../../core-compatibility-pending.schema.json"},
    "schema_version": {"const": 1},
    "core_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_]*$"
    },
    "state": {"const": "awaiting-local-e2e"},
    "publication": {"const": "disabled"},
    "core_spec_sha256": {"$ref": "#/$defs/sha256"},
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"enum": ["arm64", "armhf"]}
    },
    "next_gate": {
      "const": "selected-and-independent-reproduction-e2e"
    },
    "content_sha256": {"$ref": "#/$defs/sha256"}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
