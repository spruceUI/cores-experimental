{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spruceui.local/schemas/core-set.schema.json",
  "title": "Cores-spruce immutable local individual-core set lock",
  "type": "object",
  "required": [
    "schema_version",
    "pin_id",
    "local_only",
    "publication",
    "scope",
    "parent",
    "sources",
    "selection_policy",
    "cores",
    "summary",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "pin_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "local_only": {"const": true},
    "publication": {"const": "disabled"},
    "scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "parent": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/manifestReference"}
      ]
    },
    "sources": {
      "type": "array",
      "items": {"$ref": "#/$defs/manifestReference"}
    },
    "selection_policy": {
      "type": "object",
      "required": ["unit", "source_order", "failed_candidate", "missing_candidate", "release_action"],
      "properties": {
        "unit": {"const": "complete-core-package"},
        "source_order": {"const": "first-complete-wins"},
        "failed_candidate": {"const": "retain-parent"},
        "missing_candidate": {"const": "retain-parent"},
        "release_action": {"const": "copy-exact-package-bytes"}
      },
      "additionalProperties": false
    },
    "cores": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["decision", "selection"],
        "properties": {
          "decision": {"enum": ["select_source", "retain_parent"]},
          "source_index": {"type": "integer", "minimum": 0},
          "selection": {"$ref": "#/$defs/selection"}
        }
      }
    },
    "content_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "manifestReference": {
      "type": "object",
      "required": ["path", "file_sha256", "content_sha256", "pin_id"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "file_sha256": {"$ref": "#/$defs/sha256"},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "pin_id": {"type": "string", "minLength": 1}
      }
    },
    "storedFile": {
      "type": "object",
      "required": ["path", "sha256", "size"],
      "properties": {
        "path": {"type": "string", "pattern": "^\\.local-e2e/store/"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 1}
      }
    },
    "selection": {
      "type": "object",
      "required": [
        "tier",
        "validation_scope",
        "e2e",
        "package",
        "metadata",
        "targets",
        "selection_sha256"
      ],
      "properties": {
        "tier": {"const": "build_golden"},
        "validation_scope": {"const": "static-build-only"},
        "package": {"$ref": "#/$defs/storedFile"},
        "metadata": {"$ref": "#/$defs/storedFile"},
        "targets": {"type": "object", "minProperties": 1},
        "selection_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
