{
  "$comment": "Structural schema for strict no-float CoreSpec identities. Mandatory Python decoding additionally authenticates nested digests and enforces sorted unique core IDs plus their exact code-owned proof bindings.",
  "$defs": {
    "catalogEvidence": {
      "additionalProperties": false,
      "properties": {
        "content_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "file_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "kind": {
          "const": "artifact"
        },
        "path": {
          "const": "manifests/core-builds.json"
        },
        "schema_version": {
          "const": 1
        },
        "size": {
          "minimum": 0,
          "type": "integer"
        },
        "target_content_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "path",
        "file_sha256",
        "target_content_sha256",
        "size",
        "content_sha256"
      ],
      "type": "object"
    },
    "catalogSchemaEvidence": {
      "additionalProperties": false,
      "properties": {
        "content_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "file_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "kind": {
          "const": "artifact"
        },
        "path": {
          "const": "manifests/core-builds.schema.json"
        },
        "schema_version": {
          "const": 1
        },
        "size": {
          "minimum": 0,
          "type": "integer"
        },
        "target_content_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "path",
        "file_sha256",
        "target_content_sha256",
        "size",
        "content_sha256"
      ],
      "type": "object"
    },
    "coreSpecIdentity": {
      "additionalProperties": false,
      "properties": {
        "content_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "core_id": {
          "pattern": "^[a-z0-9][a-z0-9_]*$",
          "type": "string"
        },
        "driver": {
          "enum": [
            "direct-cargo",
            "direct-cmake",
            "direct-make",
            "libretro-super"
          ]
        },
        "legacy_catalog_spec_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "proof_binding": {
          "oneOf": [
            {
              "$ref": "#/$defs/registeredProofBinding"
            },
            {
              "$ref": "#/$defs/legacyProofBinding"
            }
          ]
        },
        "schema_version": {
          "const": 1
        },
        "strict_spec_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "schema_version",
        "core_id",
        "driver",
        "legacy_catalog_spec_sha256",
        "strict_spec_sha256",
        "proof_binding",
        "content_sha256"
      ],
      "type": "object"
    },
    "legacyProofBinding": {
      "additionalProperties": false,
      "properties": {
        "binding_id": {
          "enum": [
            "ardens",
            "arduous",
            "easyrpg",
            "ffmpeg",
            "flycast",
            "flycast2021",
            "flycast2024",
            "km_duckswanstation_xtreme_amped",
            "squirreljme",
            "swanstation",
            "tic80"
          ]
        },
        "binding_kind": {
          "const": "legacy-validator"
        },
        "proof_kind": {
          "const": "legacy-validator"
        },
        "schema_version": {
          "const": 1
        }
      },
      "required": [
        "schema_version",
        "binding_kind",
        "binding_id",
        "proof_kind"
      ],
      "type": "object"
    },
    "registeredProofBinding": {
      "additionalProperties": false,
      "properties": {
        "binding_id": {
          "pattern": "^[a-z][a-z0-9-]*-v[1-9][0-9]*$",
          "type": "string"
        },
        "binding_kind": {
          "const": "registered-log-contract"
        },
        "proof_kind": {
          "enum": [
            "core-arch",
            "core-arch-source"
          ]
        },
        "schema_version": {
          "const": 1
        }
      },
      "required": [
        "schema_version",
        "binding_kind",
        "binding_id",
        "proof_kind"
      ],
      "type": "object"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "$id": "https://spruceui.local/schemas/core-spec-set-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "catalog": {
      "$ref": "#/$defs/catalogEvidence"
    },
    "catalog_schema": {
      "$ref": "#/$defs/catalogSchemaEvidence"
    },
    "content_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "core_count": {
      "const": 100
    },
    "cores": {
      "items": {
        "$ref": "#/$defs/coreSpecIdentity"
      },
      "maxItems": 100,
      "minItems": 100,
      "type": "array",
      "uniqueItems": true
    },
    "driver_counts": {
      "additionalProperties": false,
      "properties": {
        "direct-cargo": {
          "const": 1
        },
        "direct-cmake": {
          "const": 10
        },
        "direct-make": {
          "const": 4
        },
        "libretro-super": {
          "const": 85
        }
      },
      "required": [
        "direct-cargo",
        "direct-cmake",
        "direct-make",
        "libretro-super"
      ],
      "type": "object"
    },
    "format": {
      "const": "spruce-core-spec-set-v1"
    },
    "local_only": {
      "const": true
    },
    "publication": {
      "const": "disabled"
    },
    "schema_version": {
      "const": 1
    }
  },
  "required": [
    "schema_version",
    "format",
    "catalog",
    "catalog_schema",
    "core_count",
    "driver_counts",
    "cores",
    "local_only",
    "publication",
    "content_sha256"
  ],
  "title": "Spruce strict CoreSpec identity set v1",
  "type": "object"
}
