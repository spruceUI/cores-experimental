{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spruceui.local/schemas/core-tracks.schema.json",
  "title": "Spruce manual version-channel build-pin, stability, and chipset selections",
  "type": "object",
  "required": [
    "$schema",
    "schema_version",
    "selection_model",
    "applicability_scope",
    "version_policy",
    "source_order_parent_bindings",
    "source_order_outliers",
    "spruce_branch_bases",
    "historical_release_correlation",
    "tracks",
    "content_sha256"
  ],
  "properties": {
    "$schema": {"const": "./core-tracks.schema.json"},
    "schema_version": {"const": 3},
    "selection_model": {"const": "manual-version-channel-build-pins-v3"},
    "applicability_scope": {"const": "architecture-only"},
    "version_policy": {"$ref": "#/$defs/versionPolicy"},
    "source_order_parent_bindings": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sourceOrderParentBinding"}
    },
    "source_order_outliers": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sourceOrderOutlier"}
    },
    "spruce_branch_bases": {
      "type": "object",
      "required": ["path", "content_sha256"],
      "properties": {
        "path": {"const": "manifests/spruce-core-branch-bases.json"},
        "content_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "historical_release_correlation": {
      "type": "object",
      "required": ["roster_path", "roster_content_sha256"],
      "properties": {
        "roster_path": {"const": "manifests/spruce-release-roster.json"},
        "roster_content_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "tracks": {
      "type": "object",
      "required": ["main", "nightly", "edge"],
      "properties": {
        "main": {
          "allOf": [
            {"$ref": "#/$defs/track"},
            {
              "properties": {
                "extends": {"const": null},
                "spruce_branch_basis": {
                  "allOf": [
                    {"$ref": "#/$defs/branchBasis"},
                    {"properties": {"basis_id": {"const": "spruce-main"}}}
                  ]
                }
              }
            }
          ]
        },
        "nightly": {
          "allOf": [
            {"$ref": "#/$defs/track"},
            {
              "properties": {
                "extends": {"const": "main"},
                "spruce_branch_basis": {
                  "allOf": [
                    {"$ref": "#/$defs/branchBasis"},
                    {"properties": {"basis_id": {"const": "spruce-development"}}}
                  ]
                }
              }
            }
          ]
        },
        "edge": {
          "allOf": [
            {"$ref": "#/$defs/track"},
            {
              "properties": {
                "extends": {"const": "nightly"},
                "spruce_branch_basis": {
                  "allOf": [
                    {"$ref": "#/$defs/branchBasis"},
                    {"properties": {"basis_id": {"const": "spruce-development"}}}
                  ]
                }
              }
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "content_sha256": {"$ref": "#/$defs/sha256"}
  },
  "additionalProperties": false,
  "$defs": {
    "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "coreId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_]*$"
    },
    "chipset": {
      "enum": ["universal", "h700", "a133p", "a33", "a523", "rk3566", "rk3326", "ssd202d"]
    },
    "realChipset": {
      "enum": ["h700", "a133p", "a33", "a523", "rk3566", "rk3326", "ssd202d"]
    },
    "testCell": {
      "type": "object",
      "required": [
        "build_pin_id", "tuning_profile", "applicable_chipsets", "version_slice"
      ],
      "properties": {
        "build_pin_id": {"$ref": "#/$defs/identifier"},
        "tuning_profile": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*-v[0-9]+$"
        },
        "applicable_chipsets": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/realChipset"}
        },
        "version_slice": {"$ref": "#/$defs/versionSlice"}
      },
      "additionalProperties": false
    },
    "stableCell": {
      "type": "object",
      "required": [
        "build_pin_id",
        "tuning_profile",
        "applicable_chipsets",
        "version_slice",
        "approved_test_variant_id",
        "approved_test_origin_track",
        "approved_at",
        "approved_by",
        "reason",
        "previous_stable_variant_id",
        "source_registry_content_sha256"
      ],
      "properties": {
        "build_pin_id": {"$ref": "#/$defs/identifier"},
        "tuning_profile": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*-v[0-9]+$"
        },
        "applicable_chipsets": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/realChipset"}
        },
        "version_slice": {"$ref": "#/$defs/versionSlice"},
        "approved_test_variant_id": {"$ref": "#/$defs/sha256"},
        "approved_test_origin_track": {"enum": ["main", "nightly", "edge"]},
        "approved_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "approved_by": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "reason": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "previous_stable_variant_id": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/sha256"}
          ]
        },
        "source_registry_content_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "testCells": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/chipset"},
      "additionalProperties": {"$ref": "#/$defs/testCell"}
    },
    "stableCells": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/chipset"},
      "additionalProperties": {"$ref": "#/$defs/stableCell"}
    },
    "testMap": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/coreId"},
      "additionalProperties": {"$ref": "#/$defs/testCells"}
    },
    "stableMap": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/coreId"},
      "additionalProperties": {"$ref": "#/$defs/stableCells"}
    },
    "deferredCell": {
      "type": "object",
      "required": ["state", "reason"],
      "properties": {
        "state": {"const": "deferred"},
        "reason": {"const": "no-reviewed-version-channel-build-pin"}
      },
      "additionalProperties": false
    },
    "deferredCells": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/chipset"},
      "additionalProperties": {"$ref": "#/$defs/deferredCell"}
    },
    "deferredMap": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/coreId"},
      "additionalProperties": {"$ref": "#/$defs/deferredCells"}
    },
    "branchBasis": {
      "type": "object",
      "required": ["basis_id", "basis_content_sha256"],
      "properties": {
        "basis_id": {"enum": ["spruce-main", "spruce-development"]},
        "basis_content_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "versionSlice": {
      "type": "object",
      "required": ["model", "track", "slice_time", "content_sha256"],
      "properties": {
        "model": {"const": "manual-track-version-slice-v1"},
        "track": {"enum": ["main", "nightly", "edge"]},
        "slice_time": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "content_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "sliceComparisonBasis": {
      "type": "object",
      "required": [
        "model", "track", "slice_time",
        "spruce_branch_registry_content_sha256", "basis_id",
        "basis_content_sha256", "branch", "content_sha256"
      ],
      "properties": {
        "model": {"const": "spruce-track-comparison-basis-projection-v1"},
        "track": {"enum": ["main", "nightly", "edge"]},
        "slice_time": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "spruce_branch_registry_content_sha256": {"$ref": "#/$defs/sha256"},
        "basis_id": {"enum": ["spruce-main", "spruce-development"]},
        "basis_content_sha256": {"$ref": "#/$defs/sha256"},
        "branch": {
          "type": "object",
          "required": ["repository", "ref", "commit", "tree"],
          "properties": {
            "repository": {"type": "string", "minLength": 1},
            "ref": {"type": "string", "pattern": "^refs/heads/\\S+$"},
            "commit": {"$ref": "#/$defs/sha1"},
            "tree": {"$ref": "#/$defs/sha1"}
          },
          "additionalProperties": false
        },
        "content_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "versionPolicy": {
      "type": "object",
      "required": [
        "assignment_model", "slice_model", "slice_comparison_bases",
        "slice_branch_basis_snapshots",
        "source_order_model", "levels", "edge_latest"
      ],
      "properties": {
        "assignment_model": {"const": "manual-reviewed-build-pin-v1"},
        "slice_model": {"const": "manual-track-version-slice-v1"},
        "slice_comparison_bases": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/sha256"},
          "additionalProperties": {"$ref": "#/$defs/sliceComparisonBasis"}
        },
        "slice_branch_basis_snapshots": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/sha256"},
          "additionalProperties": {"$ref": "#/$defs/sliceBranchBasisSnapshot"}
        },
        "source_order_model": {
          "const": "assignment-time-git-ancestry-or-authorized-outlier-v1"
        },
        "levels": {
          "const": {
            "main": "spruce-main",
            "nightly": "spruce-development",
            "edge": "latest-reviewed-upstream"
          }
        },
        "edge_latest": {
          "type": "object",
          "required": ["model", "snapshot", "heads"],
          "properties": {
            "model": {"const": "reviewed-remote-ref-snapshot-v1"},
            "snapshot": {"$ref": "#/$defs/edgeSnapshot"},
            "heads": {
              "type": "object",
              "minProperties": 100,
              "maxProperties": 100,
              "propertyNames": {"$ref": "#/$defs/coreId"},
              "additionalProperties": {"$ref": "#/$defs/edgeHead"}
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "sliceBranchBasisSnapshot": {
      "type": "object",
      "required": [
        "model", "branch_bases", "catalog", "release_roster",
        "catalog_file_sha256", "release_roster_file_sha256", "content_sha256"
      ],
      "properties": {
        "model": {"const": "spruce-track-branch-basis-snapshot-v1"},
        "branch_bases": {"type": "object"},
        "catalog": {"type": "object"},
        "release_roster": {"type": "object"},
        "catalog_file_sha256": {"$ref": "#/$defs/sha256"},
        "release_roster_file_sha256": {"$ref": "#/$defs/sha256"},
        "content_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "edgeSnapshot": {
      "type": "object",
      "required": ["snapshot_id", "captured_at", "file_sha256", "content_sha256"],
      "properties": {
        "snapshot_id": {"$ref": "#/$defs/identifier"},
        "captured_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "file_sha256": {"$ref": "#/$defs/sha256"},
        "content_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "edgeHead": {
      "type": "object",
      "required": [
        "repository", "requested_ref", "commit", "tree",
        "latest_semantics", "status"
      ],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "requested_ref": {"type": "string", "pattern": "^refs/(heads|tags)/\\S+$"},
        "commit": {"$ref": "#/$defs/sha1"},
        "tree": {"$ref": "#/$defs/sha1"},
        "latest_semantics": {
          "enum": ["exact-branch-tip", "catalog-tag-only-not-latest"]
        },
        "status": {"enum": ["unchanged", "fast-forward", "diverged"]}
      },
      "additionalProperties": false
    },
    "sourceOrderOutlier": {
      "type": "object",
      "required": [
        "marker", "track", "core_id", "chipset", "parent_track",
        "parent_binding_content_sha256", "child_variant_id",
        "child_cell",
        "child_build_pin_id", "child_pin_content_sha256",
        "child_source_repository", "child_source_requested_ref",
        "child_source_commit", "child_source_tree",
        "authorized_at", "authorized_by", "reason"
      ],
      "properties": {
        "marker": {"const": "test"},
        "track": {"enum": ["nightly", "edge"]},
        "core_id": {"$ref": "#/$defs/coreId"},
        "chipset": {"$ref": "#/$defs/chipset"},
        "parent_track": {"enum": ["main", "nightly"]},
        "parent_binding_content_sha256": {"$ref": "#/$defs/sha256"},
        "child_cell": {"$ref": "#/$defs/testCell"},
        "child_variant_id": {"$ref": "#/$defs/sha256"},
        "child_build_pin_id": {"$ref": "#/$defs/identifier"},
        "child_pin_content_sha256": {"$ref": "#/$defs/sha256"},
        "child_source_repository": {"type": "string", "minLength": 1},
        "child_source_requested_ref": {"type": "string", "minLength": 1},
        "child_source_commit": {"$ref": "#/$defs/sha1"},
        "child_source_tree": {"$ref": "#/$defs/sha1"},
        "authorized_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "authorized_by": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "reason": {"type": "string", "minLength": 1, "pattern": "\\S"}
      },
      "additionalProperties": false
    },
    "sourceOrderParentLineage": {
      "type": "object",
      "required": ["binding", "outlier"],
      "properties": {
        "binding": {"$ref": "#/$defs/sourceOrderParentBinding"},
        "outlier": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/sourceOrderOutlier"}
          ]
        }
      },
      "additionalProperties": false
    },
    "sourceOrderParentBinding": {
      "type": "object",
      "required": [
        "model", "track", "core_id", "chipset",
        "captured_registry_content_sha256", "parent_track",
        "parent_origin_track", "parent_selected_chipset", "parent_cell",
        "parent_variant_id", "parent_build_pin_id",
        "parent_pin_content_sha256", "parent_source_repository",
        "parent_source_requested_ref", "parent_source_commit",
        "parent_source_tree", "parent_lineage",
        "parent_selection_content_sha256", "child_variant_id",
        "child_cell",
        "child_build_pin_id", "child_pin_content_sha256",
        "child_source_repository", "child_source_requested_ref",
        "child_source_commit", "child_source_tree", "content_sha256"
      ],
      "properties": {
        "model": {"const": "assignment-time-parent-test-v1"},
        "track": {"enum": ["nightly", "edge"]},
        "core_id": {"$ref": "#/$defs/coreId"},
        "chipset": {"$ref": "#/$defs/chipset"},
        "captured_registry_content_sha256": {"$ref": "#/$defs/sha256"},
        "parent_track": {"enum": ["main", "nightly"]},
        "parent_origin_track": {"enum": ["main", "nightly"]},
        "parent_selected_chipset": {"$ref": "#/$defs/chipset"},
        "parent_cell": {"$ref": "#/$defs/testCell"},
        "parent_variant_id": {"$ref": "#/$defs/sha256"},
        "parent_build_pin_id": {"$ref": "#/$defs/identifier"},
        "parent_pin_content_sha256": {"$ref": "#/$defs/sha256"},
        "parent_source_repository": {"type": "string", "minLength": 1},
        "parent_source_requested_ref": {"type": "string", "minLength": 1},
        "parent_source_commit": {"$ref": "#/$defs/sha1"},
        "parent_source_tree": {"$ref": "#/$defs/sha1"},
        "parent_lineage": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/sourceOrderParentLineage"}
          ]
        },
        "parent_selection_content_sha256": {"$ref": "#/$defs/sha256"},
        "child_cell": {"$ref": "#/$defs/testCell"},
        "child_variant_id": {"$ref": "#/$defs/sha256"},
        "child_build_pin_id": {"$ref": "#/$defs/identifier"},
        "child_pin_content_sha256": {"$ref": "#/$defs/sha256"},
        "child_source_repository": {"type": "string", "minLength": 1},
        "child_source_requested_ref": {"type": "string", "minLength": 1},
        "child_source_commit": {"$ref": "#/$defs/sha1"},
        "child_source_tree": {"$ref": "#/$defs/sha1"},
        "content_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "track": {
      "type": "object",
      "required": ["extends", "spruce_branch_basis", "test", "stable", "deferred"],
      "properties": {
        "extends": {
          "oneOf": [
            {"type": "null"},
            {"enum": ["main", "nightly"]}
          ]
        },
        "spruce_branch_basis": {"$ref": "#/$defs/branchBasis"},
        "test": {"$ref": "#/$defs/testMap"},
        "stable": {"$ref": "#/$defs/stableMap"},
        "deferred": {"$ref": "#/$defs/deferredMap"}
      },
      "additionalProperties": false
    }
  }
}
