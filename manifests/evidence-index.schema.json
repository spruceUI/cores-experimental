{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Per-core evidence index",
  "description": "Promotion-derived bindings for one core, generated by scripts/evidence_index.py from promoted disk state; never hand-edited. Editor aid only — the normative check is `evidence_index.py verify` plus the unit suite.",
  "type": "object",
  "required": [
    "schema_version",
    "core_id",
    "semantic_id",
    "pin_path",
    "source_set_path",
    "source_commit",
    "selection_sha256",
    "package",
    "compatibility",
    "runs",
    "targets",
    "local_only_evidence",
    "publication"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "core_id": { "type": "string", "minLength": 1 },
    "semantic_id": { "type": "string", "minLength": 1 },
    "pin_path": { "type": "string" },
    "source_set_path": { "type": "string" },
    "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "selection_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "package": {
      "type": "object",
      "required": ["sha256"],
      "properties": {
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size": { "type": ["integer", "null"] }
      }
    },
    "compatibility": {
      "type": "object",
      "required": ["file_sha256", "content_sha256"]
    },
    "runs": {
      "type": "object",
      "required": ["selected", "reproduction"]
    },
    "targets": { "type": "object", "minProperties": 1 },
    "local_only_evidence": { "const": true },
    "publication": { "const": "disabled" }
  }
}
