{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spruceui.local/schemas/full-release-candidate.schema.json",
  "$comment": "Structural interoperability schema only. Mandatory Python seal validation and repository reconstruction own all cross-field semantics.",
  "title": "Cores-spruce sealed local full-release candidate",
  "type": "object",
  "required": [
    "$schema",
    "schema_version",
    "candidate_id",
    "validation_scope",
    "local_only",
    "publication",
    "result",
    "group",
    "plan",
    "runner",
    "assets",
    "summary",
    "asset_set_sha256",
    "content_sha256"
  ],
  "properties": {
    "$schema": {
      "const": "../../manifests/full-release-candidate.schema.json"
    },
    "schema_version": {"const": 2},
    "candidate_id": {"$ref": "#/$defs/identifier"},
    "validation_scope": {"const": "static-build-only"},
    "local_only": {"const": true},
    "publication": {"const": "disabled"},
    "result": {"const": "sealed"},
    "group": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "./full-release-plan.schema.json#/$defs/group"}
      ]
    },
    "plan": {"$ref": "#/$defs/planReference"},
    "runner": {"$ref": "#/$defs/runner"},
    "assets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/asset"}
    },
    "summary": {"$ref": "#/$defs/summary"},
    "asset_set_sha256": {"$ref": "#/$defs/sha256"},
    "content_sha256": {"$ref": "#/$defs/sha256"}
  },
  "additionalProperties": false,
  "$defs": {
    "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "coreId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_]*$"
    },
    "planReference": {
      "type": "object",
      "required": ["path", "file_sha256", "content_sha256"],
      "properties": {
        "path": {"const": "plan.json"},
        "file_sha256": {"$ref": "#/$defs/sha256"},
        "content_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "resultReference": {
      "type": "object",
      "required": ["path", "file_sha256", "content_sha256"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^results/[a-z0-9][a-z0-9_]*/result\\.json$"
        },
        "file_sha256": {"$ref": "#/$defs/sha256"},
        "content_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "runner": {
      "oneOf": [
        {"$ref": "#/$defs/localRunner"},
        {"$ref": "#/$defs/githubRunner"},
        {"$ref": "#/$defs/simulatedGithubRunner"}
      ]
    },
    "localRunner": {
      "type": "object",
      "required": ["profile", "mode", "backend", "local_only", "publication"],
      "properties": {
        "profile": {"const": "local"},
        "mode": {"const": "native"},
        "backend": {"const": "local-docker"},
        "local_only": {"const": true},
        "publication": {"const": "disabled"}
      },
      "additionalProperties": false
    },
    "githubRunner": {
      "type": "object",
      "required": ["profile", "mode", "backend", "local_only", "publication"],
      "properties": {
        "profile": {"const": "github-actions"},
        "mode": {"const": "native"},
        "backend": {"const": "github-hosted-docker"},
        "local_only": {"const": true},
        "publication": {"const": "disabled"}
      },
      "additionalProperties": false
    },
    "simulatedGithubRunner": {
      "type": "object",
      "required": ["profile", "mode", "backend", "local_only", "publication"],
      "properties": {
        "profile": {"const": "github-actions"},
        "mode": {"const": "simulated"},
        "backend": {"const": "local-docker"},
        "local_only": {"const": true},
        "publication": {"const": "disabled"}
      },
      "additionalProperties": false
    },
    "asset": {
      "type": "object",
      "required": ["core_id", "path", "sha256", "size", "core_group", "result"],
      "properties": {
        "core_id": {"$ref": "#/$defs/coreId"},
        "path": {
          "type": "string",
          "pattern": "^assets/[A-Za-z0-9][A-Za-z0-9._+-]*_libretro\\.zip$"
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 1},
        "core_group": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/coreGroupMarker"}
          ]
        },
        "result": {"$ref": "#/$defs/resultReference"}
      },
      "additionalProperties": false
    },
    "coreGroupMarker": {
      "type": "object",
      "required": [
        "group_tag",
        "variant_id",
        "requested_marker",
        "requested_chipset",
        "selected_chipset",
        "selected_state",
        "stability",
        "resolution",
        "test_origin_track",
        "spruce_branch_basis",
        "pin_id",
        "source_commit",
        "selected_architectures"
      ],
      "properties": {
        "group_tag": {
          "type": "string",
          "pattern": "^(main|nightly|edge)-(stable|test):(universal|h700|a133p|a33|a523|rk3566|rk3326|ssd202d)$"
        },
        "variant_id": {"$ref": "#/$defs/sha256"},
        "requested_marker": {"enum": ["stable", "test"]},
        "requested_chipset": {"enum": ["universal", "h700", "a133p", "a33", "a523", "rk3566", "rk3326", "ssd202d"]},
        "selected_chipset": {"enum": ["universal", "h700", "a133p", "a33", "a523", "rk3566", "rk3326", "ssd202d"]},
        "selected_state": {"enum": ["stable", "unstable_fallback", "test"]},
        "stability": {"enum": ["stable", "unstable"]},
        "resolution": {"enum": ["exact_stable", "universal_stable_fallback", "exact_test_unstable_fallback", "universal_test_unstable_fallback", "exact_test", "universal_test_fallback"]},
        "test_origin_track": {"enum": ["main", "nightly", "edge"]},
        "spruce_branch_basis": {"$ref": "#/$defs/spruceBranchBasis"},
        "pin_id": {"$ref": "#/$defs/identifier"},
        "source_commit": {"$ref": "#/$defs/sha1"},
        "selected_architectures": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["arm64", "armhf"]}
        }
      },
      "additionalProperties": false
    },
    "spruceBranchBasis": {
      "type": "object",
      "required": ["basis_id", "basis_content_sha256"],
      "properties": {
        "basis_id": {"enum": ["spruce-main", "spruce-development"]},
        "basis_content_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": ["core_count", "asset_count", "asset_bytes"],
      "properties": {
        "core_count": {"type": "integer", "minimum": 1},
        "asset_count": {"type": "integer", "minimum": 1},
        "asset_bytes": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  }
}
