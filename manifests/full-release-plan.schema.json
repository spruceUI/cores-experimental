{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spruceui.local/schemas/full-release-plan.schema.json",
  "$comment": "Structural interoperability schema only. Mandatory Python release-plan validation and repository reconstruction own all cross-field semantics.",
  "title": "Cores-spruce deterministic local full-release plan",
  "type": "object",
  "required": [
    "$schema",
    "schema_version",
    "candidate_id",
    "scope",
    "validation_scope",
    "local_only",
    "publication",
    "group",
    "repository",
    "cores",
    "summary",
    "content_sha256"
  ],
  "properties": {
    "$schema": {"const": "../../manifests/full-release-plan.schema.json"},
    "schema_version": {"const": 3},
    "candidate_id": {"$ref": "#/$defs/identifier"},
    "scope": {
      "enum": ["explicit", "canonical", "full-workflow-roster", "track-group"]
    },
    "validation_scope": {"const": "static-build-only"},
    "local_only": {"const": true},
    "publication": {"const": "disabled"},
    "group": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/group"}
      ]
    },
    "repository": {"$ref": "#/$defs/repository"},
    "cores": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/core"}
    },
    "summary": {"$ref": "#/$defs/summary"},
    "content_sha256": {"$ref": "#/$defs/sha256"}
  },
  "additionalProperties": false,
  "$defs": {
    "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "coreId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_]*$"
    },
    "repositoryPath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._+-]+(?:/[A-Za-z0-9._+-]+)*$"
    },
    "fileReference": {
      "type": "object",
      "required": ["path", "file_sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/repositoryPath"},
        "file_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "contentReference": {
      "type": "object",
      "required": ["path", "file_sha256", "content_sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/repositoryPath"},
        "file_sha256": {"$ref": "#/$defs/sha256"},
        "content_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "pipelineBundle": {
      "type": "object",
      "required": ["file_sha256", "content_sha256"],
      "properties": {
        "file_sha256": {"$ref": "#/$defs/sha256"},
        "content_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "repository": {
      "type": "object",
      "required": [
        "head",
        "clean",
        "catalog",
        "toolchain_lock",
        "commit_blacklist",
        "pipeline_bundle",
        "workflow_audit",
        "orchestration"
      ],
      "properties": {
        "head": {"$ref": "#/$defs/sha1"},
        "clean": {"const": true},
        "catalog": {"$ref": "#/$defs/fileReference"},
        "toolchain_lock": {"$ref": "#/$defs/contentReference"},
        "commit_blacklist": {"$ref": "#/$defs/contentReference"},
        "pipeline_bundle": {"$ref": "#/$defs/pipelineBundle"},
        "workflow_audit": {"$ref": "#/$defs/workflowAudit"},
        "orchestration": {"$ref": "#/$defs/orchestration"}
      },
      "additionalProperties": false
    },
    "orchestration": {
      "type": "object",
      "required": ["coordinator", "worker"],
      "properties": {
        "coordinator": {
          "type": "object",
          "required": ["path", "file_sha256"],
          "properties": {
            "path": {"const": ".github/workflows/release-candidate.yml"},
            "file_sha256": {"$ref": "#/$defs/sha256"}
          },
          "additionalProperties": false
        },
        "worker": {
          "type": "object",
          "required": ["path", "file_sha256"],
          "properties": {
            "path": {"const": ".github/workflows/_build-one-core.yml"},
            "file_sha256": {"$ref": "#/$defs/sha256"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "workflowAudit": {
      "type": "object",
      "required": [
        "schema_version",
        "content_sha256",
        "core_workflow_count",
        "catalog_workflow_count",
        "shared_pipeline_workflows",
        "unmigrated_workflow_count"
      ],
      "properties": {
        "schema_version": {"const": 2},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "core_workflow_count": {"type": "integer", "minimum": 0},
        "catalog_workflow_count": {"type": "integer", "minimum": 0},
        "shared_pipeline_workflows": {"type": "integer", "minimum": 0},
        "unmigrated_workflow_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "groupTag": {
      "type": "string",
      "pattern": "^(main|nightly|edge)-(stable|test):(universal|h700|a133p|a33|a523|rk3566|rk3326|ssd202d)$"
    },
    "group": {
      "type": "object",
      "required": [
        "group_tag",
        "inventory_state",
        "track_registry",
        "tuning_registry",
        "release_roster",
        "spruce_branch_bases",
        "stable_core_count",
        "unstable_fallback_core_count",
        "test_core_count"
      ],
      "properties": {
        "group_tag": {"$ref": "#/$defs/groupTag"},
        "inventory_state": {"enum": ["stable", "unstable"]},
        "track_registry": {"$ref": "#/$defs/contentReference"},
        "tuning_registry": {"$ref": "#/$defs/contentReference"},
        "release_roster": {"$ref": "#/$defs/contentReference"},
        "spruce_branch_bases": {"$ref": "#/$defs/contentReference"},
        "stable_core_count": {"type": "integer", "minimum": 0},
        "unstable_fallback_core_count": {"type": "integer", "minimum": 0},
        "test_core_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "spruceBranchBasis": {
      "type": "object",
      "required": ["basis_id", "basis_content_sha256"],
      "properties": {
        "basis_id": {"enum": ["spruce-main", "spruce-development"]},
        "basis_content_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "artifactIdentity": {
      "type": "object",
      "required": ["sha256", "size"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "coreGroup": {
      "type": "object",
      "required": [
        "schema_version",
        "validation_scope",
        "group_tag",
        "inventory_content_sha256",
        "track_registry_content_sha256",
        "tuning_registry_content_sha256",
        "spruce_branch_basis",
        "core_id",
        "variant_id",
        "requested_marker",
        "requested_chipset",
        "selected_chipset",
        "selected_state",
        "stability",
        "resolution",
        "test_origin_track",
        "pin",
        "source_commit",
        "execution_source",
        "recipe_compatibility",
        "selected_architectures",
        "tuning",
        "expected_outputs"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "validation_scope": {"const": "pinned-output-reproduction-v1"},
        "group_tag": {"$ref": "#/$defs/groupTag"},
        "inventory_content_sha256": {"$ref": "#/$defs/sha256"},
        "track_registry_content_sha256": {"$ref": "#/$defs/sha256"},
        "tuning_registry_content_sha256": {"$ref": "#/$defs/sha256"},
        "spruce_branch_basis": {"$ref": "#/$defs/spruceBranchBasis"},
        "core_id": {"$ref": "#/$defs/coreId"},
        "variant_id": {"$ref": "#/$defs/sha256"},
        "requested_marker": {"enum": ["stable", "test"]},
        "requested_chipset": {"enum": ["universal", "h700", "a133p", "a33", "a523", "rk3566", "rk3326", "ssd202d"]},
        "selected_chipset": {"enum": ["universal", "h700", "a133p", "a33", "a523", "rk3566", "rk3326", "ssd202d"]},
        "selected_state": {"enum": ["stable", "unstable_fallback", "test"]},
        "stability": {"enum": ["stable", "unstable"]},
        "resolution": {"enum": ["exact_stable", "universal_stable_fallback", "exact_test_unstable_fallback", "universal_test_unstable_fallback", "exact_test", "universal_test_fallback"]},
        "test_origin_track": {"enum": ["main", "nightly", "edge"]},
        "pin": {"$ref": "#/$defs/pin"},
        "source_commit": {"$ref": "#/$defs/sha1"},
        "execution_source": {"$ref": "#/$defs/source"},
        "recipe_compatibility": {
          "type": "object",
          "required": ["model", "selected_pin_core_spec_sha256", "execution_core_spec_sha256", "core_spec_identity_match"],
          "properties": {
            "model": {"const": "source-normalized-build-contract-v1"},
            "selected_pin_core_spec_sha256": {"$ref": "#/$defs/sha256"},
            "execution_core_spec_sha256": {"$ref": "#/$defs/sha256"},
            "core_spec_identity_match": {"type": "boolean"}
          },
          "additionalProperties": false
        },
        "selected_architectures": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["arm64", "armhf"]}
        },
        "tuning": {
          "type": "object",
          "required": ["profile_id", "content_sha256", "properties", "compiler_argument_mapping_version", "compiler_arguments"],
          "properties": {
            "profile_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
            "content_sha256": {"$ref": "#/$defs/sha256"},
            "properties": {"type": "object"},
            "compiler_argument_mapping_version": {"type": "string", "minLength": 1},
            "compiler_arguments": {"type": "array", "items": {"type": "string", "minLength": 1}}
          },
          "additionalProperties": false
        },
        "expected_outputs": {
          "type": "object",
          "required": ["targets", "metadata", "package"],
          "properties": {
            "targets": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {"enum": ["arm64", "armhf"]},
              "additionalProperties": {
                "type": "object",
                "required": ["artifact"],
                "properties": {"artifact": {"$ref": "#/$defs/artifactIdentity"}},
                "additionalProperties": false
              }
            },
            "metadata": {"$ref": "#/$defs/artifactIdentity"},
            "package": {
              "type": "object",
              "required": ["comparison", "name", "sha256", "size"],
              "properties": {
                "comparison": {"const": "exact"},
                "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*_libretro\\.zip$"},
                "sha256": {"$ref": "#/$defs/sha256"},
                "size": {"type": "integer", "minimum": 1}
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "approval": {
          "type": "object",
          "required": ["approved_test_variant_id", "approved_test_origin_track", "approved_at", "approved_by", "reason", "previous_stable_variant_id", "source_registry_content_sha256"],
          "properties": {
            "approved_test_variant_id": {"$ref": "#/$defs/sha256"},
            "approved_test_origin_track": {"enum": ["main", "nightly", "edge"]},
            "approved_at": {"type": "string", "minLength": 1},
            "approved_by": {"type": "string", "minLength": 1},
            "reason": {"type": "string", "minLength": 1},
            "previous_stable_variant_id": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
            "source_registry_content_sha256": {"$ref": "#/$defs/sha256"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "submodule": {
      "type": "object",
      "required": ["path", "commit"],
      "properties": {
        "path": {"$ref": "#/$defs/repositoryPath"},
        "commit": {"$ref": "#/$defs/sha1"}
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["url", "requested_ref", "commit", "tree", "submodules"],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://(?![^/\\s]*@)(?![^\\s]*[?#])[^\\s/?#]+/[^\\s?#]*\\.git$"
        },
        "requested_ref": {
          "type": "string",
          "pattern": "^refs/(heads|tags)/[^\\s]+$"
        },
        "commit": {"$ref": "#/$defs/sha1"},
        "tree": {"$ref": "#/$defs/sha1"},
        "submodules": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/submodule"}
        }
      },
      "additionalProperties": false
    },
    "workflow": {
      "type": "object",
      "required": ["path", "file_sha256"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^\\.github/workflows/build-[A-Za-z0-9._+-]+\\.yml$"
        },
        "file_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "pin": {
      "type": "object",
      "required": ["path", "pin_id", "file_sha256", "content_sha256"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^pins/core-sets/[A-Za-z0-9._-]+\\.json$"
        },
        "pin_id": {"$ref": "#/$defs/identifier"},
        "file_sha256": {"$ref": "#/$defs/sha256"},
        "content_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "sourceSet": {
      "type": "object",
      "required": [
        "path",
        "source_set_id",
        "file_sha256",
        "content_sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^pins/source-sets/[A-Za-z0-9._-]+\\.json$"
        },
        "source_set_id": {"$ref": "#/$defs/identifier"},
        "file_sha256": {"$ref": "#/$defs/sha256"},
        "content_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "compatibility": {
      "type": "object",
      "required": ["path", "file_sha256", "content_sha256"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^manifests/compatibility/[a-z0-9][a-z0-9_]*\\.json$"
        },
        "file_sha256": {"$ref": "#/$defs/sha256"},
        "content_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "package": {
      "type": "object",
      "required": ["name", "sha256", "size"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*_libretro\\.zip$"
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "required": [
        "architecture",
        "execution_profile",
        "artifact_name",
        "artifact_sha256",
        "artifact_size",
        "selected_build_record_sha256"
      ],
      "properties": {
        "architecture": {"enum": ["arm64", "armhf"]},
        "execution_profile": {
          "type": "string",
          "pattern": "^ra(32|64)-[a-z0-9-]+-v[0-9]+$"
        },
        "artifact_name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*_libretro\\.so$"
        },
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "artifact_size": {"type": "integer", "minimum": 1},
        "selected_build_record_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "core": {
      "type": "object",
      "required": [
        "core_id",
        "core_spec_sha256",
        "workflow",
        "source",
        "pin",
        "source_set",
        "compatibility",
        "package",
        "targets",
        "core_group"
      ],
      "properties": {
        "core_id": {"$ref": "#/$defs/coreId"},
        "core_spec_sha256": {"$ref": "#/$defs/sha256"},
        "workflow": {"$ref": "#/$defs/workflow"},
        "source": {"$ref": "#/$defs/source"},
        "pin": {"$ref": "#/$defs/pin"},
        "source_set": {"$ref": "#/$defs/sourceSet"},
        "compatibility": {"$ref": "#/$defs/compatibility"},
        "package": {"$ref": "#/$defs/package"},
        "core_group": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/coreGroup"}
          ]
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/target"}
        }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": ["core_count", "target_count", "package_bytes"],
      "properties": {
        "core_count": {"type": "integer", "minimum": 1},
        "target_count": {"type": "integer", "minimum": 1},
        "package_bytes": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  }
}
