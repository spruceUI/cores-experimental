{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spruceui.local/schemas/local-release.schema.json",
  "title": "Cores-spruce immutable local core release",
  "type": "object",
  "required": [
    "schema_version",
    "release_id",
    "local_only",
    "publication",
    "pin",
    "assets",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "release_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "local_only": {"const": true},
    "publication": {"const": "disabled"},
    "pin": {
      "type": "object",
      "required": ["pin_id", "file_sha256", "content_sha256"],
      "properties": {
        "pin_id": {"type": "string", "minLength": 1},
        "file_sha256": {"$ref": "#/$defs/sha256"},
        "content_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "core_id",
          "path",
          "sha256",
          "size",
          "source_tier",
          "selection_sha256"
        ],
        "properties": {
          "core_id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "pattern": "^[A-Za-z0-9._+-]+_libretro\\.zip$"},
          "sha256": {"$ref": "#/$defs/sha256"},
          "size": {"type": "integer", "minimum": 1},
          "source_tier": {"const": "build_golden"},
          "selection_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "content_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
