{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://spruceui.local/schemas/optimization-profiles.schema.json",
    "title": "Cores-spruce typed optimization profiles",
    "type": "object",
    "required": [
        "$schema",
        "schema_version",
        "build_argument_mapping_version",
        "profiles",
        "content_sha256"
    ],
    "additionalProperties": false,
    "properties": {
        "$schema": {
            "const": "./optimization-profiles.schema.json"
        },
        "schema_version": {
            "const": 1
        },
        "build_argument_mapping_version": {
            "const": "libretro-make-optimization-v1"
        },
        "profiles": {
            "type": "object",
            "minProperties": 1,
            "required": [
                "release-v1"
            ],
            "propertyNames": {
                "pattern": "^[a-z0-9][a-z0-9-]*-v[0-9]+$"
            },
            "additionalProperties": {
                "$ref": "#/$defs/profile"
            },
            "properties": {
                "release-v1": {
                    "$ref": "#/$defs/baselineProfile"
                }
            }
        },
        "content_sha256": {
            "$ref": "#/$defs/sha256"
        }
    },
    "$defs": {
        "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
        },
        "profile": {
            "type": "object",
            "required": [
                "extends",
                "properties"
            ],
            "additionalProperties": false,
            "properties": {
                "extends": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "pattern": "^[a-z0-9][a-z0-9-]*-v[0-9]+$"
                },
                "properties": {
                    "$ref": "#/$defs/profileProperties"
                }
            }
        },
        "baselineProfile": {
            "description": "The baseline must contribute nothing, so an unselected optimization dimension reproduces the recorded golden artifacts byte for byte.",
            "type": "object",
            "required": [
                "extends",
                "properties"
            ],
            "additionalProperties": false,
            "properties": {
                "extends": {
                    "const": null
                },
                "properties": {
                    "type": "object",
                    "maxProperties": 0
                }
            }
        },
        "profileProperties": {
            "description": "Typed intent only. Code owns the mapping from intent to make variables and to the compile tokens the build log must prove.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "variant": {
                    "enum": [
                        "release",
                        "debug"
                    ]
                },
                "expect_opt_level": {
                    "enum": [
                        "0",
                        "1",
                        "2",
                        "3",
                        "s"
                    ]
                },
                "expect_debug_info": {
                    "type": "boolean"
                }
            },
            "dependentRequired": {
                "expect_opt_level": [
                    "variant"
                ],
                "expect_debug_info": [
                    "variant"
                ]
            }
        }
    }
}
