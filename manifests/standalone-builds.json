      "toolchain": "arm64-standalone",
      "source_date_epoch": 1786747058,
      "env": {
        "PKG_CONFIG_PATH": "/opt/flycast-standalone-deps-arm64/lib/pkgconfig",
        "PKG_CONFIG_LIBDIR": "/opt/flycast-standalone-deps-arm64/lib/pkgconfig:/usr/lib/aarch64-linux-gnu/pkgconfig"
      },
      "cmake": {
        "target": "flycast",
        "cross_defines": {
          "CMAKE_FIND_ROOT_PATH": "/usr/aarch64-linux-gnu;/opt/flycast-standalone-deps-arm64;/usr",
          "CMAKE_FIND_ROOT_PATH_MODE_LIBRARY": "ONLY",
          "CMAKE_FIND_ROOT_PATH_MODE_INCLUDE": "BOTH",
          "CMAKE_FIND_ROOT_PATH_MODE_PROGRAM": "NEVER",
          "CMAKE_LIBRARY_PATH": "/usr/lib/aarch64-linux-gnu;/opt/flycast-standalone-deps-arm64/lib",
