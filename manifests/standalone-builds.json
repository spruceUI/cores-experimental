{
  "note": "Standalone (non-libretro) emulators spruce ships. Fields: docs/standalone.md.",
  "builds": {
    "flycast-standalone": {
      "description": "Flycast v2.7: Emu/DC/flycast on every 64-bit device (Dreamcast, NAOMI, Atomiswave)",
      "source": {
