          "CMAKE_PREFIX_PATH": "/opt/flycast-standalone-deps-arm64",
          "CMAKE_C_FLAGS": "-O3 -I/opt/flycast-standalone-deps-arm64/include",
          "CMAKE_CXX_FLAGS": "-O3 -I/opt/flycast-standalone-deps-arm64/include",
          "CMAKE_EXE_LINKER_FLAGS": "-L/opt/flycast-standalone-deps-arm64/lib -L/usr/lib/aarch64-linux-gnu -Wl,-rpath-link,/opt/flycast-standalone-deps-arm64/lib -Wl,-rpath-link,/usr/lib/aarch64-linux-gnu"
        },
        "defines": {
          "LIBRETRO": "OFF",
          "USE_HOST_SDL": "ON",
          "USE_OPENGL": "ON",
          "USE_GLES": "ON",
          "USE_VULKAN": "ON",
          "USE_ALSA": "ON",
          "USE_HOST_LIBZIP": "OFF",
          "USE_OPENMP": "OFF",
          "USE_PULSEAUDIO": "OFF",
          "USE_LIBAO": "OFF",
          "USE_LUA": "OFF",
          "USE_DISCORD": "OFF",
          "ENABLE_CTEST": "OFF",
          "FT_DISABLE_PNG": "ON",
          "FT_DISABLE_HARFBUZZ": "ON",
          "FT_DISABLE_BROTLI": "ON",
          "FT_DISABLE_BZIP2": "ON"
        }
      },
      "output": {
        "files": [
          {
            "from": "/tmp/standalone-build/flycast",
            "to": "flycast",
            "strip": "-s"
          },
          {
            "from": "/opt/flycast-standalone-deps-arm64/lib/libcurl.so.4",
            "to": "lib64/libcurl.so.4",
            "strip": "-s"
