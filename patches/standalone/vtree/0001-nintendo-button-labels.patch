From spruceUI/vTree-spruce@d3a0a5a:patches/common/0001-nintendo-button-labels.patch, unchanged.

From: spruceUI <spruceUI@local>
Subject: [PATCH] Use Nintendo-style face button labels

Spruce/Trimui/Miyoo devices use Nintendo physical layout
(A=east, B=south, X=north, Y=west). SDL2's GameController API
normalizes button names to Xbox layout (a=south, b=east), so
without this swap the Settings UI displays "Confirm: b" when the
user has bound the labeled-A button — confusing on a Nintendo-
labeled handheld.
---
 keyboard.c | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/keyboard.c b/keyboard.c
--- a/keyboard.c
+++ b/keyboard.c
@@ -248,10 +248,10 @@ const char *btn_label(SDL_GameControllerButton btn) {
 const char *btn_label(SDL_GameControllerButton btn) {
     if (btn == SDL_CONTROLLER_BUTTON_INVALID) return "---";
     const char *s = SDL_GameControllerGetStringForButton(btn);
     if (!s) return "?";
-    if (strcmp(s, "a")             == 0) return "A";
-    if (strcmp(s, "b")             == 0) return "B";
-    if (strcmp(s, "x")             == 0) return "X";
-    if (strcmp(s, "y")             == 0) return "Y";
+    if (strcmp(s, "a")             == 0) return "B";
+    if (strcmp(s, "b")             == 0) return "A";
+    if (strcmp(s, "x")             == 0) return "Y";
+    if (strcmp(s, "y")             == 0) return "X";
     if (strcmp(s, "start")         == 0) return "Start";
     if (strcmp(s, "guide")         == 0) return "Guide";
     if (strcmp(s, "back")          == 0) return "Select";
