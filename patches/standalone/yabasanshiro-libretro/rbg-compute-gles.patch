Subject: [PATCH 3/3] RBG compute: unsigned literals in the 16bpp palette fetch

GLSL ES has no implicit int-to-uint conversion, so every 16bpp-palette variant failed to compile
and createProgram aborted the core; all 200 variants now pass glslangValidator for ES 3.10.
---
 yabause/src/ygl_texture.cpp | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/yabause/src/ygl_texture.cpp b/yabause/src/ygl_texture.cpp
index 25829e6f..51df88a8 100644
--- a/yabause/src/ygl_texture.cpp
+++ b/yabause/src/ygl_texture.cpp
@@ -591,8 +591,8 @@ const char prg_rbg_getcolor_16bpp_palette[] =
 "  uint dotaddr = charaddr + uint((y*cellw)+x) * 2u;\n"
 "  dot = vram[dotaddr>>2]; \n" 
 "  if( (dotaddr & 0x02u) != 0u ) { dot >>= 16; } \n"
-"  dot = (((dot) >> 8 & 0xFF) | ((dot) & 0xFF) << 8);\n"
-"  if ( dot == 0 && transparencyenable != 0 ) { \n"
+"  dot = (((dot) >> 8 & 0xFFu) | ((dot) & 0xFFu) << 8);\n"
+"  if ( dot == 0u && transparencyenable != 0 ) { \n"
 "    cramindex = 0u; \n"
 "    alpha = 0.0;\n"
 "  } else {\n"
