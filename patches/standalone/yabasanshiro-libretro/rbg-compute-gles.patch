From 253cf8683d0b773b4987eb6a69cf337631bf0559 Mon Sep 17 00:00:00 2001
From: arkun <56165886+CatalyticArkun@users.noreply.github.com>
Date: Tue, 13 Oct 2026 11:00:00 -0500
Subject: [PATCH 2/3] RBG compute: order the layer's texture reads and VRAM
 uploads

texelFetch needs GL_TEXTURE_FETCH_BARRIER_BIT after the image stores, and the unsynchronised
VRAM map could overwrite data a queued dispatch had not read yet; orphan the buffer instead.
---
 yabause/src/ygl_texture.cpp | 8 +++++---
 1 file changed, 5 insertions(+), 3 deletions(-)

diff --git a/yabause/src/ygl_texture.cpp b/yabause/src/ygl_texture.cpp
index 837b690e..25829e6f 100644
--- a/yabause/src/ygl_texture.cpp
+++ b/yabause/src/ygl_texture.cpp
@@ -2512,7 +2512,8 @@ public:
 
   glBindBuffer(GL_SHADER_STORAGE_BUFFER, ssbo_vram_);
   //glBufferSubData(GL_SHADER_STORAGE_BUFFER, 0, 0x80000, (void*)Vdp2Ram);
-  if(mapped_vram == nullptr) mapped_vram = glMapBufferRange(GL_SHADER_STORAGE_BUFFER, 0, 0x80000, GL_MAP_WRITE_BIT | GL_MAP_UNSYNCHRONIZED_BIT);
+  // the whole VRAM is rewritten: orphan the old copy rather than write it under a pending dispatch
+  if(mapped_vram == nullptr) mapped_vram = glMapBufferRange(GL_SHADER_STORAGE_BUFFER, 0, 0x80000, GL_MAP_WRITE_BIT | GL_MAP_INVALIDATE_BUFFER_BIT);
   memcpy(mapped_vram, Vdp2Ram, 0x80000);
   glUnmapBuffer(GL_SHADER_STORAGE_BUFFER);
   mapped_vram = nullptr;
@@ -2605,7 +2606,8 @@ public:
 
   //-----------------------------------------------
   GLuint getTexture( int id ) { 
-    glMemoryBarrier(GL_SHADER_IMAGE_ACCESS_BARRIER_BIT);
+    // the layer is read with texelFetch, which only the texture fetch barrier orders after image stores
+    glMemoryBarrier(GL_SHADER_IMAGE_ACCESS_BARRIER_BIT | GL_TEXTURE_FETCH_BARRIER_BIT);
 		if (id == 1) {
 			return tex_surface_;
 		}
@@ -2616,7 +2618,7 @@ public:
   void onFinish() {
     if ( ssbo_vram_ != 0 && mapped_vram == nullptr) {
       glBindBuffer(GL_SHADER_STORAGE_BUFFER, ssbo_vram_);
-      mapped_vram = glMapBufferRange(GL_SHADER_STORAGE_BUFFER, 0, 0x80000, GL_MAP_WRITE_BIT | GL_MAP_UNSYNCHRONIZED_BIT);
+      mapped_vram = glMapBufferRange(GL_SHADER_STORAGE_BUFFER, 0, 0x80000, GL_MAP_WRITE_BIT | GL_MAP_INVALIDATE_BUFFER_BIT);
       glBindBuffer(GL_SHADER_STORAGE_BUFFER, 0 );
     }
   }
-- 
