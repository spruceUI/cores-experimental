@@ -121,6 +122,20 @@
 
 static void PerUpdateConfig(PerBaseConfig_struct * baseconfig, int nelems, void * controller);
 
+// spruce: a 3D pad trigger with no analog axis bound follows its digital L/R (00 released, FF pressed);
+// it used to rest at the 7F init value, read as half pressed
+static void Per3DPadDigitalTrigger(PerPad_struct * pad, u8 axis, int byte, u8 val)
+{
+   u32 i;
+
+   if (pad->perid != PER3DPAD)
+      return;
+   for (i = 0; i < perkeyconfigsize; i++)
+      if (perkeyconfig[i].controller == (void *)pad && perkeyconfig[i].base->name == axis && perkeyconfig[i].bound)
+         return;
+   ((PerAnalog_struct *)pad)->analogbits[byte] = val;
+}
+
