 int PerInit(int coreid) {
@@ -305,6 +320,7 @@
 
 void PerPadRTriggerPressed(PerPad_struct * pad) {
    *(pad->padbits + 1) &= 0x7F;
+   Per3DPadDigitalTrigger(pad, PERANALOG_AXIS3, 4, 0xFF);
    SMPCLOG("Right Trigger\n");
 }
 
@@ -312,12 +328,14 @@
 
 void PerPadRTriggerReleased(PerPad_struct * pad) {
    *(pad->padbits + 1) |= ~0x7F;
+   Per3DPadDigitalTrigger(pad, PERANALOG_AXIS3, 4, 0x00);
 }
 
 //////////////////////////////////////////////////////////////////////////////
 
 void PerPadLTriggerPressed(PerPad_struct * pad) {
    *(pad->padbits + 1) &= 0xF7;
+   Per3DPadDigitalTrigger(pad, PERANALOG_AXIS4, 5, 0xFF);
    SMPCLOG("Left Trigger\n");
 }
 
@@ -325,6 +343,7 @@
 
 void PerPadLTriggerReleased(PerPad_struct * pad) {
    *(pad->padbits + 1) |= ~0xF7;
+   Per3DPadDigitalTrigger(pad, PERANALOG_AXIS4, 5, 0x00);
 }
 
