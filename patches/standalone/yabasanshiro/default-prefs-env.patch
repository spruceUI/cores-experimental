+
+bool Preference::chosen( const std::string & key, const json & compiled ){
+  if( j.find(key) == j.end() ) return false;
+  if( j.find(CHOSEN) != j.end() && j[CHOSEN].is_array() ){
+    for( auto & k : j[CHOSEN] ) if( k == key ) return true;
+  }
+  return j[key] != compiled;  // older builds saved the compiled default on every read
+}
+
+void Preference::mark( const std::string & key ){
+  if( j.find(CHOSEN) == j.end() || !j[CHOSEN].is_array() ) j[CHOSEN] = json::array();
+  for( auto & k : j[CHOSEN] ) if( k == key ) return;
+  j[CHOSEN].push_back(key);
+}
 
