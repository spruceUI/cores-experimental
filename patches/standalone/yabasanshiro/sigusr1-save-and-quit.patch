+// spruce: resume support (SIGUSR1 save-and-quit, auto-load). <itemnum>_auto.yss: the menu's 5 slots are numbered, so
+// the auto state never shows there and never overwrites one. Discs without an item number would share one: none.
+std::string yb_auto_state_path( const std::string & state_dir, const char * itemnum ){
+  if( itemnum == NULL || *itemnum == '\0' ) return std::string();
+  return state_dir + itemnum + "_auto.yss";
+}
+
+// a quit saves only with auto-save on, a usable name, and the auto-load done: a quit while the game boots keeps the
+// player's resume point instead of saving the boot over it
+bool yb_save_on_quit( bool autosave, const std::string & auto_state, bool autoload_pending ){
+  return autosave && !auto_state.empty() && !autoload_pending;
+}
+
+std::string yb_set_aside( const std::string & path ){
+  std::string bad = path + ".bad";
+  return rename(path.c_str(), bad.c_str()) == 0 ? bad : std::string();
+}
+
+bool yb_env_on( const char * name ){
+  const char * v = getenv(name);
+  return v != NULL && strcmp(v, "1") == 0;
+}
+
+int yb_save_atomic( const std::string & path, int (*save)( const char * ) ){
+  std::string tmp = path + ".tmp";
+  int ret = save(tmp.c_str());
+  if( ret != 0 ){ remove(tmp.c_str()); return ret; }
+  if( rename(tmp.c_str(), path.c_str()) != 0 ){ remove(tmp.c_str()); return -10; }
+  return 0;
+}
