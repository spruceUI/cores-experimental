+// spruce: states apart from battery saves. YB_STATE_DIR holds the save states, their thumbnails and the menu's
+// screenshot, HOME keeps backup.bin; unset, everything stays in HOME/.yabasanshiro/ as upstream.
+std::string yb_state_dir(){
+  const char * dir = getenv("YB_STATE_DIR");
+  if( dir != NULL && *dir ) return std::string(dir) + "/";
+  return std::string(getenv("HOME")) + "/.yabasanshiro/";
+}
